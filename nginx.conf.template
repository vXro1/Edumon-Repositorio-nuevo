# Este archivo se "splicea" dentro del bloque http{} del nginx.conf base de
# la imagen (vía `include /etc/nginx/conf.d/*.conf;`) — por eso puede tener
# directivas de nivel http (map, resolver, gzip) sueltas aquí arriba, sin
# envolverlas en su propio `http { }`.

# Necesario para que el proxy de /socket.io/ soporte el upgrade de conexión
# a WebSocket: cuando el navegador manda "Connection: Upgrade" (intentando
# pasar de long-polling a WebSocket), $http_upgrade trae "websocket" y acá
# se reenvía tal cual ("upgrade"). Cuando NO es un upgrade (polling normal
# u otras peticiones), $http_upgrade viene vacío y se manda "close" en su
# lugar — es el patrón estándar recomendado por la propia documentación de
# nginx para proxyear WebSockets.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# 127.0.0.11 es el DNS embebido de Docker en cualquier red bridge definida
# por el usuario (ver docker-compose.yml). A nivel http aplica a todos los
# server{} de este archivo (el de abajo y el de HTTPS, cuando se active).
resolver 127.0.0.11 valid=10s;

gzip on;
gzip_vary on;
gzip_min_length 1024;
gzip_types text/css application/javascript application/json image/svg+xml font/woff2 font/woff text/plain;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Resolver el nombre del backend por variable en vez de literal en
    # proxy_pass es a propósito: con un literal, nginx resuelve el hostname
    # UNA sola vez al arrancar y si el backend todavía no está levantado
    # (orden de arranque de compose) o no existe (ej. corriendo este
    # contenedor suelto, sin compose), nginx se niega a iniciar por
    # completo — cae TODO el frontend por un problema de un solo location.
    # Con variable + resolver (de arriba), la resolución es por-petición:
    # si el backend no está, esa ruta responde 502 pero el resto del sitio
    # (los estáticos) sigue sirviendo.
    set $backend_upstream "${BACKEND_INTERNAL_URL}";

    # Vite versiona sus assets con un hash de contenido en el nombre
    # (ej. index-a1b2c3d4.js) — se pueden cachear para siempre. index.html,
    # en cambio, jamás se cachea: es lo único que debe releerse en cada
    # deploy para que el navegador se entere de que hay assets nuevos.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Reenvía puerta adentro (misma red de Docker) al backend por su nombre
    # de servicio interno — el navegador nunca ve esta URL, solo llama a
    # /api/... sobre el propio origen del frontend. De paso evita CORS y
    # hace que la cookie de sesión (httpOnly, SameSite=None en producción)
    # viaje como same-site incluso en un docker-compose local.
    #
    # BACKEND_INTERNAL_URL se resuelve al arrancar el contenedor (ver
    # docker-entrypoint.sh) — por defecto http://backend:4000, el nombre de
    # servicio definido en docker-compose.yml. El backend monta TODAS sus
    # rutas reales bajo /api (/api/auth/..., /api/cursos/..., etc. — el "/"
    # suelto es solo su healthcheck), así que este proxy debe preservar el
    # /api/... tal cual, no recortarlo.
    #
    # proxy_pass $backend_upstream$request_uri — a propósito, NO
    # "proxy_pass $backend_upstream/;": con un proxy_pass literal (sin
    # variable), nginx SÍ reescribe automáticamente la URI reemplazando el
    # prefijo del location por lo que sigue al host. Pero en cuanto el
    # destino de proxy_pass usa una variable (nuestro caso, por el
    # resolver), nginx deja de hacer esa reescritura automática por
    # completo y, si no se le da una URI explícita, reenvía SIEMPRE la raíz
    # del backend sin importar qué pidió el navegador (bug real que se
    # detectó probando esta misma imagen: todo /api/* llegaba como "/" al
    # backend). $request_uri arma la URL a mano con la ruta y query string
    # originales intactos, evitando ambos problemas a la vez.
    location /api/ {
        proxy_pass $backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cookie_path / /;
        client_max_body_size 210m;
    }

    # Archivos subidos (fotos, adjuntos, APK) y avatares predeterminados:
    # los sirve el backend desde su almacenamiento local. /uploads/priv/*
    # exige sesión (el backend valida la cookie).
    location /uploads/ {
        proxy_pass $backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cookie_path / /;
    }

    location /static/ {
        proxy_pass $backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Socket.IO (notificaciones en tiempo real) — el backend lo monta con
    # `new Server(server, {...})` SIN "path" propio, así que usa el default
    # de la librería: /socket.io/ (confirmado en Backend Edumon/src/app.js).
    # Es una ruta y un tipo de conexión distintos a /api/: arranca como
    # HTTP long-polling normal en este mismo path y el navegador intenta
    # "subirla" a WebSocket con un header "Connection: Upgrade" — un proxy
    # HTTP común (como el de /api/ arriba) no sabe reenviar ese upgrade y
    # la conexión nunca pasa de polling. Mismo criterio de $backend_upstream
    # + resolver que /api/ (para no tumbar nginx si el backend no está
    # listo), más los headers de upgrade y timeouts largos (una conexión de
    # WebSocket se queda abierta minutos/horas — el timeout por defecto de
    # nginx, 60s, la cortaría a media conversación).
    location /socket.io/ {
        proxy_pass $backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cookie_path / /;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # SPA: react-router-dom resuelve las rutas en el cliente (BrowserRouter,
    # no hash routing) — cualquier ruta que no sea un archivo real en disco
    # (ej. /cursos/123, /familia/entregas) debe caer en index.html para que
    # React Router la interprete, en vez de que nginx devuelva un 404.
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ============================================================================
# HTTPS — apagado a propósito, listo para activar cuando infraestructura
# defina dominio + certificado. NO se genera ni se inventa ningún
# certificado acá; esto es solo la plantilla de config.
#
# Para activarlo, sin reescribir nada de lo de arriba:
#
#   1. Conseguir el certificado (ej. Let's Encrypt / certbot, o el que
#      entregue infraestructura) como dos archivos: fullchain.pem y
#      privkey.pem.
#   2. Montarlos como volumen de solo lectura en el contenedor del
#      frontend, en docker-compose.yml:
#        frontend:
#          volumes:
#            - /ruta/en/la/VM/certs:/etc/nginx/certs:ro
#   3. Descomentar el server{} de abajo, reemplazar TU_DOMINIO_AQUI por el
#      dominio real, y confirmar que las rutas de ssl_certificate /
#      ssl_certificate_key coincidan con lo montado en el paso 2.
#   4. Este contenedor corre SIN privilegios (usuario "nginx", no root) —
#      por eso HTTP quedó en el puerto 8080 y no el 80. Un proceso sin
#      privilegios tampoco puede bindear el 443 directo. Dos formas de
#      resolverlo (elegir UNA, no requiere tocar esta plantilla):
#        a) Dejar `listen 8443 ssl;` como está abajo y publicar en
#           docker-compose.yml `ports: ["443:8443"]` (Docker sí puede
#           mapear el 443 del host a un puerto interno no privilegiado).
#        b) Cambiar a `listen 443 ssl;` y agregarle al servicio
#           `cap_add: [NET_BIND_SERVICE]` en docker-compose.yml.
#   5. Opcional pero recomendado: agregar un server{} adicional en el 8080
#      que solo haga `return 301 https://$host$request_uri;` para forzar
#      HTTPS, una vez el dominio esté funcionando.
